# SecureGate — environment variables template
# -----------------------------------------------
# Copy this file to a NEW file named  .env
# Fill in real values before running locally.
# NEVER commit your .env file to version control.
# -----------------------------------------------

# A long random string used to sign JWT access tokens.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# Example value (not real):  4f9a2b...
APP_SIGNING_KEY=replace-me-with-a-long-random-string

# Path to the SQLite database file (relative to project root).
# Default used when this variable is absent: securegate.db
APP_DATABASE_PATH=securegate.db

# JWT token lifetime in minutes.
# Default used when this variable is absent: 30
APP_TOKEN_MINUTES=30
